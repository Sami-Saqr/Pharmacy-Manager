<Window x:Class="PharmacyManager.Views.UnsavedChangesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="عمل غير محفوظ"
        SizeToContent="WidthAndHeight"
        MinWidth="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource AppFontFamily}"
        Background="{StaticResource ContentBackgroundBrush}">
    <Border Style="{StaticResource ContentPanelCardStyle}" Margin="16">
        <StackPanel>
            <TextBlock Text="يوجد عمل غير محفوظ. هل تريد المتابعة والخروج؟"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,22" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="الرجوع للشاشة"
                        Style="{StaticResource OutlineButtonStyle}"
                        MinWidth="130"
                        IsDefault="True"
                        Click="ReturnToScreen_Click"
                        Margin="0,0,10,0" />
                <Button Content="الخروج وتجاهل التغييرات"
                        Style="{StaticResource PrimaryButtonStyle}"
                        MinWidth="180"
                        Click="DiscardChanges_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
