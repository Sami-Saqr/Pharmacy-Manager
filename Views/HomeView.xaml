<UserControl x:Class="PharmacyManager.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24,28,18">
            <StackPanel Margin="0,0,0,22">
                <TextBlock Text="مساحة العمل"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="اختر القسم الذي تريد العمل فيه."
                           FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,5,0,0" />
            </StackPanel>

            <ItemsControl ItemsSource="{Binding Sections}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource ContentPanelCardStyle}"
                                Padding="18"
                                Margin="0,0,0,18"
                                BorderBrush="{Binding AccentLightBrush}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <Border Width="4"
                                            Height="22"
                                            CornerRadius="2"
                                            Background="{Binding AccentBrush}"
                                            Margin="0,0,10,0" />
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="23"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>

                                <ItemsControl ItemsSource="{Binding Tiles}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource HomeTileButtonStyle}"
                                                    Width="{Binding Width}"
                                                    MinWidth="{Binding MinWidth}"
                                                    Height="{Binding Height}"
                                                    MinHeight="{Binding MinHeight}"
                                                    Margin="0,0,12,12"
                                                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding NavigationItem}">
                                                <StackPanel VerticalAlignment="Center">
                                                    <Border Width="44"
                                                            Height="44"
                                                            CornerRadius="22"
                                                            Background="{StaticResource HomeTileIconBackgroundBrush}"
                                                            HorizontalAlignment="Right"
                                                            Margin="0,0,0,12">
                                                        <Path Data="{Binding NavigationItem.IconPathData}"
                                                              Fill="{StaticResource HomeTileTextBrush}"
                                                              Width="21"
                                                              Height="21"
                                                              Stretch="Uniform"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center" />
                                                    </Border>
                                                    <TextBlock Text="{Binding NavigationItem.Title}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource HomeTileTextBrush}"
                                                               TextWrapping="Wrap"
                                                               MaxHeight="54"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding NavigationItem.Title}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="FontSize" Value="20" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsProminent}" Value="True">
                                                                        <Setter Property="FontSize" Value="26" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Description}"
                                                               FontSize="14"
                                                               Foreground="{StaticResource HomeTileTextBrush}"
                                                               Margin="0,5,0,0"
                                                               TextWrapping="Wrap"
                                                               MaxHeight="38"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding Description}" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14,10"
                    Margin="0,0,0,4">
                <StackPanel>
                    <TextBlock Text="{Binding DataContext.StoreName, RelativeSource={RelativeSource AncestorType=Window}}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Text="الإصدار 1.0.0 • .NET 10 LTS"
                               FontSize="10"
                               Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,3,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
