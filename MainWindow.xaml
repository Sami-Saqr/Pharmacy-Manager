<Window x:Class="PharmacyManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:PharmacyManager.ViewModels"
        mc:Ignorable="d"
        Title="PharmacyManager — نظام إدارة الصيدلية"
        Height="820" Width="1340"
        MinHeight="680" MinWidth="1040"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource AppFontFamily}"
        Background="{StaticResource AppBackgroundBrush}">

    <Window.DataContext>
        <viewmodels:MainViewModel />
    </Window.DataContext>

    <Window.InputBindings>
        <KeyBinding Key="Home" Modifiers="Alt" Command="{Binding GoHomeCommand}" />
    </Window.InputBindings>

    <Grid Background="{StaticResource ContentBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource CardBackgroundBrush}"
                BorderThickness="0,0,0,1"
                BorderBrush="{StaticResource BorderBrush}"
                Padding="20,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding GoHomeCommand}"
                            Padding="12,0"
                            Margin="0,0,12,0"
                            FontSize="12">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource OutlineButtonStyle}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHome}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="← الرئيسية" />
                    </Button>
                    <TextBlock Text="{Binding CurrentScreenTitle}"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Border Background="#F1F5F9" CornerRadius="6" Padding="10,6" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"
                                  Fill="{StaticResource PrimaryBlueBrush}"
                                  Width="13" Height="13" Stretch="Uniform"
                                  Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding StoreBranch}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border Background="#ECFDF5"
                            BorderBrush="#A7F3D0"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8,4">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="#10B981" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="قاعدة البيانات: متصلة محلياً"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#047857" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,14,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentDate}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   HorizontalAlignment="Right" />
                        <TextBlock Text="ساعات العمل: 08:00 ص - 10:00 م"
                                   FontSize="10"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Right"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                    <Border Background="#F1F5F9" CornerRadius="20" Padding="8,4">
                        <StackPanel Orientation="Horizontal">
                            <Border Background="{StaticResource PrimaryBlueBrush}"
                                    CornerRadius="14"
                                    Width="28"
                                    Height="28"
                                    Margin="0,0,8,0">
                                <TextBlock Text="أ"
                                           FontWeight="Bold"
                                           FontSize="13"
                                           Foreground="#FFFFFF"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{Binding CurrentUser}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <ContentControl Content="{Binding CurrentViewModel}" Focusable="False" />

            <Border HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="20"
                    Padding="12,8"
                    CornerRadius="6"
                    Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    Visibility="{Binding IsNavigationLoading, Converter={StaticResource BoolToVisConverter}}"
                    IsHitTestVisible="False">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ProgressBar Width="42" Height="4" IsIndeterminate="True" />
                    <TextBlock Text="جارٍ تحميل البيانات"
                               Margin="10,0,0,0"
                               FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
