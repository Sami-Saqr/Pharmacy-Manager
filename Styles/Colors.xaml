<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- الألوان الأساسية لتطبيق قطع غيار السيارات -->
    
    <!-- خلفيات التطبيق -->
    <Color x:Key="AppBackground">#F1F5F9</Color>
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackground}" />

    <Color x:Key="ContentBackground">#F8FAFC</Color>
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="{StaticResource ContentBackground}" />

    <Color x:Key="CardBackground">#FFFFFF</Color>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackground}" />

    <!-- ألوان التمييز (Accents) -->
    <Color x:Key="PrimaryBlue">#2563EB</Color>
    <SolidColorBrush x:Key="PrimaryBlueBrush" Color="{StaticResource PrimaryBlue}" />

    <Color x:Key="PrimaryHover">#1D4ED8</Color>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource PrimaryHover}" />

    <!-- حالات النظام والبطاقات (Stats) -->
    <Color x:Key="SalesGreen">#059669</Color>
    <SolidColorBrush x:Key="SalesGreenBrush" Color="{StaticResource SalesGreen}" />
    <Color x:Key="SalesGreenLight">#ECFDF5</Color>
    <SolidColorBrush x:Key="SalesGreenLightBrush" Color="{StaticResource SalesGreenLight}" />

    <Color x:Key="InvoicesIndigo">#4F46E5</Color>
    <SolidColorBrush x:Key="InvoicesIndigoBrush" Color="{StaticResource InvoicesIndigo}" />
    <Color x:Key="InvoicesIndigoLight">#EEF2FF</Color>
    <SolidColorBrush x:Key="InvoicesIndigoLightBrush" Color="{StaticResource InvoicesIndigoLight}" />

    <!-- Filled Home tile backgrounds, darkened for strong white-text contrast -->
    <SolidColorBrush x:Key="HomeSalesTileBrush" Color="#047857" />
    <SolidColorBrush x:Key="HomeSalesTileHoverBrush" Color="#065F46" />
    <SolidColorBrush x:Key="HomeOperationsTileBrush" Color="#1D4ED8" />
    <SolidColorBrush x:Key="HomeOperationsTileHoverBrush" Color="#1E40AF" />
    <SolidColorBrush x:Key="HomeFinanceTileBrush" Color="#5B21B6" />
    <SolidColorBrush x:Key="HomeFinanceTileHoverBrush" Color="#4C1D95" />
    <SolidColorBrush x:Key="HomeTileTextBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="HomeTileIconBackgroundBrush" Color="#33FFFFFF" />

    <Color x:Key="ProductsTeal">#0891B2</Color>
    <SolidColorBrush x:Key="ProductsTealBrush" Color="{StaticResource ProductsTeal}" />
    <Color x:Key="ProductsTealLight">#ECFEFF</Color>
    <SolidColorBrush x:Key="ProductsTealLightBrush" Color="{StaticResource ProductsTealLight}" />

    <Color x:Key="AlertRed">#DC2626</Color>
    <SolidColorBrush x:Key="AlertRedBrush" Color="{StaticResource AlertRed}" />
    <Color x:Key="AlertRedLight">#FEF2F2</Color>
    <SolidColorBrush x:Key="AlertRedLightBrush" Color="{StaticResource AlertRedLight}" />

    <Color x:Key="WarningAmber">#D97706</Color>
    <SolidColorBrush x:Key="WarningAmberBrush" Color="{StaticResource WarningAmber}" />

    <!-- ألوان النصوص والحدود -->
    <Color x:Key="TextPrimary">#0F172A</Color>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}" />

    <Color x:Key="TextSecondary">#64748B</Color>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}" />

    <Color x:Key="TextMuted">#94A3B8</Color>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMuted}" />

    <Color x:Key="BorderColor">#E2E8F0</Color>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />

</ResourceDictionary>
