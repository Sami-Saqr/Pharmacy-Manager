<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>PharmacyManager</AssemblyName>
    <RootNamespace>PharmacyManager</RootNamespace>
  </PropertyGroup>

  <!-- استثناء مجلد النسخ الاحتياطية أو المجلدات الإضافية من التجميع لمنع تكرار الكلاسات -->
  <ItemGroup>
    <Compile Remove="New folder\**" />
    <Page Remove="New folder\**" />
    <None Include="New folder\**" />
  </ItemGroup>

  <!-- استثناء مشروع الاختبار المتداخل من تجميع التطبيق (مطلوب لأنه موجود داخل مجلد التطبيق) لمنع تكرار الخصائص -->
  <ItemGroup>
    <Compile Remove="PharmacyManager.Tests\**" />
    <EmbeddedResource Remove="PharmacyManager.Tests\**" />
    <None Remove="PharmacyManager.Tests\**" />
    <Page Remove="PharmacyManager.Tests\**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
  </ItemGroup>

</Project>
